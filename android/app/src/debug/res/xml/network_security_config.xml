<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development only: allows http:// to the local backend (LAN IP or 10.0.2.2 on the emulator). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
