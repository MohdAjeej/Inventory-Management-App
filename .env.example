# Copy to .env and adjust. .env is git-ignored.
POSTGRES_DB=inventory_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

DB_URL=jdbc:postgresql://localhost:5434/inventory_platform
DB_USERNAME=postgres
DB_PASSWORD=change-me

SERVER_PORT=8082
# At least 32 bytes, base64. Generate with: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=replace-with-a-long-random-base64-secret
